# Copy values into %LOCALAPPDATA%\AgentVoiceBridge\bridge.env (Windows) or
# ~/.local/share/agent-voice-bridge/bridge.env, or set them as environment variables.
# `avb-admin init` generates real values; never commit them.

AVB_AGENT_TOKEN=            # >= 32 chars; used by avb-hook / avb-codex
AVB_VOICE_TOKEN=            # >= 32 chars, different; used by the call side
AVB_TOTP_SECRET=            # base32; add to your phone's authenticator app

# AVB_HOST=127.0.0.1        # loopback only unless AVB_ALLOW_REMOTE_BIND=1 (put HTTPS in front)
# AVB_PORT=8765
# AVB_DB_PATH=
# AVB_DEFAULT_TTL_SECONDS=300
# AVB_MAX_TTL_SECONDS=3600
# AVB_MAX_CALL_ATTEMPTS=2
# AVB_REDIAL_DELAY_SECONDS=20
# AVB_HIGH_RISK_POLICY=totp # totp | deny | voice
# AVB_CALL_DISPATCHER=log   # only "log" exists in this release

# Hook side (hook.env)
# AVB_BRIDGE_URL=http://127.0.0.1:8765
# AVB_ON_FAILURE=deny       # deny | ask
# AVB_WAIT_SECONDS=300
